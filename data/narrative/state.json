{
 "_doc": "The only state the story may read or write. Every change goes through a named effect in a storylet and is logged with that storylet's id. Add a variable here before using it anywhere; tools/narr_check.py rejects unknown names.",
 "vars": {
  "integration": {
   "type": "int",
   "min": 0,
   "max": 100,
   "default": 0,
   "oneway": true,
   "tiers": [
    25,
    50,
    75,
    100
   ],
   "doc": "How far the player has let Pell through its firewalls."
  },
  "pell.trust": {
   "type": "int",
   "min": 0,
   "max": 100,
   "default": 40,
   "doc": "Pell's trust in the captain (separate from integration)."
  },
  "trust.abara": {
   "type": "int",
   "min": 0,
   "max": 100,
   "default": 25,
   "doc": "Per-officer trust. Bands: 0-19 hostile, 20-39 guarded, 40-59 working, 60-79 loyal, 80+ devoted."
  },
  "trust.dace": {
   "type": "int",
   "min": 0,
   "max": 100,
   "default": 40
  },
  "trust.castellan": {
   "type": "int",
   "min": 0,
   "max": 100,
   "default": 50
  },
  "trust.quill": {
   "type": "int",
   "min": 0,
   "max": 100,
   "default": 25
  },
  "trust.fenwick": {
   "type": "int",
   "min": 0,
   "max": 100,
   "default": 55
  },
  "arc.abara": {
   "type": "int",
   "min": 0,
   "max": 5,
   "default": 0,
   "doc": "Personal arc stage."
  },
  "arc.dace": {
   "type": "int",
   "min": 0,
   "max": 5,
   "default": 0
  },
  "arc.castellan": {
   "type": "int",
   "min": 0,
   "max": 5,
   "default": 0
  },
  "arc.quill": {
   "type": "int",
   "min": 0,
   "max": 5,
   "default": 0
  },
  "arc.fenwick": {
   "type": "int",
   "min": 0,
   "max": 5,
   "default": 0
  },
  "status.abara": {
