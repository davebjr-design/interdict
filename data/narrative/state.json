  },
  "status.castellan": {
   "type": "enum",
   "values": [
    "steady",
    "shaken",
    "estranged",
    "mutinous",
    "transferred"
   ],
   "default": "steady"
  },
  "status.quill": {
   "type": "enum",
   "values": [
    "steady",
    "shaken",
    "estranged",
    "mutinous",
    "transferred"
   ],
   "default": "steady"
  },
  "status.fenwick": {
   "type": "enum",
   "values": [
    "steady",
    "shaken",
    "estranged",
    "mutinous",
    "transferred"
   ],
   "default": "steady"
