  }
 },
 "patterns": {
  "knows.<fact>": "bool. fact must exist in knowledge.csv. The player has learned it.",
  "told.<fact>.<crew>": "bool. fact must exist in knowledge.csv; crew is an officer id or pell. That person was told.",
  "seen.<storylet_id>": "bool, set automatically when a storylet plays (powers once/cooldown)."
 }
}